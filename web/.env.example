# Vite development/preview server proxies /api to this address; never put credentials here.
NEW_API_URL=http://127.0.0.1:3000

# Public New API console URL for the embedded original Model Square.
# Use the same browser hostname and scheme as the canvas so the HttpOnly session cookie is shared.
# Build the updated new-api/web frontend and restart the gateway after changing its UI.
VITE_NEW_API_CONSOLE_URL=http://127.0.0.1:3000
